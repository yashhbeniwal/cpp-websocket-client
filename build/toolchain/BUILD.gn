toolchain("default") {
  tool("cc") {
    command = "g++ -MMD -MF {{output}}.d {{defines}} {{include_dirs}} {{cflags}} {{cflags_cc}} -c {{source}} -o {{output}}"
    depfile = "{{output}}.d"
    depsformat = "gcc"
  }

  tool("cxx") {
    command = "g++ -MMD -MF {{output}}.d {{defines}} {{include_dirs}} {{cflags}} {{cflags_cc}} -c {{source}} -o {{output}}"
    depfile = "{{output}}.d"
    depsformat = "gcc"
  }

  tool("alink") {
    command = "ar rcs {{output}} {{inputs}}"
  }

  tool("link") {
    command = "g++ {{inputs}} -o {{output}} {{libs}}"
  }
}
